# Pexels API (gratuit) - https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay API (gratuit) - https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# TikTok API (approuve par TikTok) - https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_REFRESH_TOKEN=your_tiktok_refresh_token

# Google Drive (optionnel - pour stockage cloud)
GOOGLE_DRIVE_CREDENTIALS=path/to/credentials.json

# --- Bot Telegram FactVibes Tout-en-un (voir telegram_bot.py) ---
# Crée un bot avec @BotFather puis colle ici son token.
TELEGRAM_BOT_TOKEN=123456789:AA...ton_token_ici
# Chat IDs autorisés (séparés par des virgules). Vide = tout le monde.
# Obtiens le tien via @userinfobot. ex: TELEGRAM_ALLOWED_IDS=123456789
TELEGRAM_ALLOWED_IDS=

# --- video-ai (voir docs/video-ai/README.md) — noms uniquement, jamais de valeurs dans Git ---
# Hugging Face (facultatif) : un compte gratuit + token fait passer le quota ZeroGPU de 2 à 5 min/jour
HF_TOKEN=
# Comfy Cloud (uniquement si l'accès API est confirmé/disponible ; NON confirmé pour l'offre gratuite)
COMFY_API_KEY=
# AI Horde : aucune variable — clé anonyme publique (0000000000) intégrée dans cloud/horde_image.py
